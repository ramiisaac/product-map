{
  "$id": "https://product-map.dev/schemas/product-map.v1/diff-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ext": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "generatedFrom": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "minLength": 7,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "derivedFrom": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workingTree": {
          "enum": [
            "clean",
            "dirty",
            "not-applicable"
          ],
          "type": "string"
        }
      },
      "required": [
        "commit",
        "workingTree",
        "sources"
      ],
      "type": "object"
    },
    "generator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "change": {
            "description": "product-map.v1 diffChange; known values: added, removed, changed, renamed",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "ext": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "fieldChanges": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "from": {},
                "path": {
                  "minLength": 1,
                  "type": "string"
                },
                "to": {}
              },
              "required": [
                "path"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "fromId": {
            "anyOf": [
              {
                "pattern": "^surface:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
                "type": "string"
              },
              {
                "pattern": "^cap:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
                "type": "string"
              }
            ]
          },
          "id": {
            "anyOf": [
              {
                "pattern": "^surface:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
                "type": "string"
              },
              {
                "pattern": "^cap:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
                "type": "string"
              }
            ]
          },
          "note": {
            "type": "string"
          },
          "toId": {
            "anyOf": [
              {
                "pattern": "^surface:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
                "type": "string"
              },
              {
                "pattern": "^cap:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "change"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "const": "diff",
      "type": "string"
    },
    "schemaVersion": {
      "const": "product-map.v1",
      "type": "string"
    },
    "scope": {
      "minLength": 1,
      "type": "string"
    },
    "stance": {
      "enum": [
        "existing",
        "planned",
        "derived"
      ],
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "stance",
    "scope",
    "generatedFrom",
    "generator",
    "contentHash",
    "items"
  ],
  "type": "object"
}
