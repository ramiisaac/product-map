{
  "$id": "https://product-map.dev/schemas/product-map.v1/capability-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ext": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "generatedFrom": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "minLength": 7,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "derivedFrom": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workingTree": {
          "enum": [
            "clean",
            "dirty",
            "not-applicable"
          ],
          "type": "string"
        }
      },
      "required": [
        "commit",
        "workingTree",
        "sources"
      ],
      "type": "object"
    },
    "generator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "auth": {
            "additionalProperties": false,
            "properties": {
              "required": {
                "type": "boolean"
              },
              "scheme": {
                "type": "string"
              },
              "scopes": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "required"
            ],
            "type": "object"
          },
          "doctrine": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ext": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "id": {
            "pattern": "^cap:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
            "type": "string"
          },
          "inputs": {
            "items": {},
            "type": "array"
          },
          "kind": {
            "description": "product-map.v1 capabilityKind; known values: route, query, mutation, action, command, event, stream, entity, schema, service, package, config, extension-api, email-contract, lsp-method, diagnostic, webhook, job, queue-job, mcp-tool, check, rule, reporter, plugin-api, report, artifact, agent-skill, agent-subagent, other",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "outputs": {
            "items": {},
            "type": "array"
          },
          "owners": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "placement": {
            "additionalProperties": false,
            "properties": {
              "canonical": {
                "minLength": 1,
                "type": "string"
              },
              "current": {
                "minLength": 1,
                "type": "string"
              },
              "verdict": {
                "description": "product-map.v1 placementVerdict; known values: correct, misplaced, unknown",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "type": "string"
              }
            },
            "required": [
              "current",
              "verdict"
            ],
            "type": "object"
          },
          "provenance": {
            "additionalProperties": false,
            "properties": {
              "confidence": {
                "description": "product-map.v1 confidence; known values: high, medium, low",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "type": "string"
              },
              "evidence": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "source": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "source",
              "evidence",
              "confidence"
            ],
            "type": "object"
          },
          "purpose": {
            "minLength": 1,
            "type": "string"
          },
          "reach": {
            "description": "product-map.v1 reach; known values: external, internal, unknown",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "shape": {},
          "sideEffects": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "description": "product-map.v1 capabilityStatus; known values: live, partial, preview, planned, absent, deprecated, unknown",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "surfaceArea": {
            "description": "product-map.v1 surfaceArea; known values: web, api, db, cli, tui, lsp, vscode, jetbrains, zed, email, github-action, mcp, sdk, worker, daemon, edge, docs, agent, other",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "telemetry": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "surfaceArea",
          "status",
          "reach",
          "placement",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "const": "capability",
      "type": "string"
    },
    "schemaVersion": {
      "const": "product-map.v1",
      "type": "string"
    },
    "scope": {
      "minLength": 1,
      "type": "string"
    },
    "stance": {
      "enum": [
        "existing",
        "planned",
        "derived"
      ],
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "stance",
    "scope",
    "generatedFrom",
    "generator",
    "contentHash",
    "items"
  ],
  "type": "object"
}
