{
  "$id": "https://product-map.dev/schemas/product-map.v1/surface-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ext": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "generatedFrom": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "minLength": 7,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "derivedFrom": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workingTree": {
          "enum": [
            "clean",
            "dirty",
            "not-applicable"
          ],
          "type": "string"
        }
      },
      "required": [
        "commit",
        "workingTree",
        "sources"
      ],
      "type": "object"
    },
    "generator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "actions": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "boundCapability": {
                  "pattern": "^cap:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
                  "type": "string"
                },
                "description": {
                  "minLength": 1,
                  "type": "string"
                },
                "id": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "id",
                "description"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "audience": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "binds": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "capabilityId": {
                  "pattern": "^cap:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
                  "type": "string"
                },
                "note": {
                  "type": "string"
                },
                "via": {
                  "description": "product-map.v1 bindVia; known values: explicit, inferred-high, candidate-only",
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "type": "string"
                }
              },
              "required": [
                "capabilityId",
                "via"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "components": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "dataNeeds": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "boundCapability": {
                  "pattern": "^cap:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
                  "type": "string"
                },
                "description": {
                  "minLength": 1,
                  "type": "string"
                },
                "id": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "id",
                "description"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "entry": {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "description": "product-map.v1 entryKind; known values: route, command, panel, view, extension-point, email-template, mcp-tool, api-doc, generated-artifact, bin, config-file",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "type": "string"
              },
              "value": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "type": "object"
          },
          "ext": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "id": {
            "pattern": "^surface:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
            "type": "string"
          },
          "interactions": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "outboundLinks": {
            "items": {
              "pattern": "^surface:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
              "type": "string"
            },
            "type": "array"
          },
          "placement": {
            "additionalProperties": false,
            "properties": {
              "canonical": {
                "minLength": 1,
                "type": "string"
              },
              "current": {
                "minLength": 1,
                "type": "string"
              },
              "verdict": {
                "description": "product-map.v1 placementVerdict; known values: correct, misplaced, unknown",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "type": "string"
              }
            },
            "required": [
              "current",
              "verdict"
            ],
            "type": "object"
          },
          "provenance": {
            "additionalProperties": false,
            "properties": {
              "confidence": {
                "description": "product-map.v1 confidence; known values: high, medium, low",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "type": "string"
              },
              "evidence": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "source": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "source",
              "evidence",
              "confidence"
            ],
            "type": "object"
          },
          "purpose": {
            "minLength": 1,
            "type": "string"
          },
          "states": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "description": "product-map.v1 surfaceStatus; known values: live, partial, prototype, planned, absent, stale, unknown",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "surfaceType": {
            "description": "product-map.v1 surfaceType; known values: marketing, docs, dashboard, admin, playground, explorer, report, vscode, jetbrains, zed, lsp, cli, tui, email, notification, github-action, github-app, mcp, api-docs, sdk-docs, registry, build-plugin, lint-plugin, desktop, macos, browser-extension, agent-plugin, other",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "views": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "minLength": 1,
                  "type": "string"
                },
                "name": {
                  "minLength": 1,
                  "type": "string"
                },
                "purpose": {
                  "type": "string"
                },
                "states": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "id",
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "surfaceType",
          "name",
          "entry",
          "purpose",
          "audience",
          "status",
          "binds",
          "placement",
          "provenance"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "const": "surface",
      "type": "string"
    },
    "schemaVersion": {
      "const": "product-map.v1",
      "type": "string"
    },
    "scope": {
      "minLength": 1,
      "type": "string"
    },
    "stance": {
      "enum": [
        "existing",
        "planned",
        "derived"
      ],
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "stance",
    "scope",
    "generatedFrom",
    "generator",
    "contentHash",
    "items"
  ],
  "type": "object"
}
