{
  "$id": "https://product-map.dev/schemas/product-map.v1/map-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contentHash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ext": {
      "additionalProperties": {},
      "propertyNames": {
        "type": "string"
      },
      "type": "object"
    },
    "generatedFrom": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "minLength": 7,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "derivedFrom": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workingTree": {
          "enum": [
            "clean",
            "dirty",
            "not-applicable"
          ],
          "type": "string"
        }
      },
      "required": [
        "commit",
        "workingTree",
        "sources"
      ],
      "type": "object"
    },
    "generator": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "id": {
                  "anyOf": [
                    {
                      "pattern": "^surface:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
                      "type": "string"
                    },
                    {
                      "pattern": "^cap:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
                      "type": "string"
                    }
                  ]
                },
                "reason": {
                  "minLength": 1,
                  "type": "string"
                },
                "score": {
                  "maximum": 1,
                  "minimum": 0,
                  "type": "number"
                }
              },
              "required": [
                "id",
                "score",
                "reason"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "capabilityId": {
            "pattern": "^cap:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
            "type": "string"
          },
          "ext": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "note": {
            "type": "string"
          },
          "relationship": {
            "description": "product-map.v1 mapRelationship; known values: bound, bound-proposed, bound-conflict, surface-unbound, capability-unbound",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "type": "string"
          },
          "surfaceId": {
            "pattern": "^surface:[a-z0-9][a-z0-9-]*:[a-z0-9][a-z0-9.-]*$",
            "type": "string"
          }
        },
        "required": [
          "relationship"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "kind": {
      "const": "map",
      "type": "string"
    },
    "schemaVersion": {
      "const": "product-map.v1",
      "type": "string"
    },
    "scope": {
      "minLength": 1,
      "type": "string"
    },
    "stance": {
      "enum": [
        "existing",
        "planned",
        "derived"
      ],
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "stance",
    "scope",
    "generatedFrom",
    "generator",
    "contentHash",
    "items"
  ],
  "type": "object"
}
